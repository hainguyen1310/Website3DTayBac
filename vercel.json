{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/contact-reply.js": { "maxDuration": 60 },
    "api/mail-sync.js": { "maxDuration": 60 },
    "api/staff-invite.js": { "maxDuration": 60 },
    "api/render.js": { "maxDuration": 60, "includeFiles": "dist/seo-shell.html" },
    "api/seo.js": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "website3dtaybac.vercel.app" }],
      "destination": "https://asintaybac.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.asintaybac.com" }],
      "destination": "https://asintaybac.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/seo?asset=robots" },
    { "source": "/sitemap.xml", "destination": "/api/seo?asset=sitemap" },
    { "source": "/((?!api/).*)", "destination": "/api/render?asin_path=$1" }
  ]
}
