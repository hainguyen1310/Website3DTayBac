# Only VITE_ values are public. Never prefix a server secret with VITE_.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Dung lượng tối đa cho mỗi ảnh tải lên Supabase Storage (MB).
# Bucket site-images cũng giới hạn 10MB trong migration storage.
VITE_MAX_UPLOAD_MB=10

# Server API environment (Vercel or local Node only; NEVER committed real values).
# Production secrets belong in Vercel Environment Variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=https://your-store-domain.example

# User-confirmed sender. Port 587 uses STARTTLS; certificate verification stays enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=noreply@asintaybac.com
SMTP_USER=
SMTP_PASSWORD=
# Optional: an actual monitored mailbox, if different from SMTP_FROM.
EMAIL_REPLY_TO=

# Optional incoming email. Set only after confirming the receiving mailbox.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Initial sync defaults to the last 30 days, then continues from its saved UID.
IMAP_SINCE=
